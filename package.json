{
  "name": "droidbridge",
  "version": "1.0.0",
  "description": "Dual-Pane Ubuntu <-> Android GUI File Manager (Web App & Ubuntu Desktop App in 1)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite --port 5173",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
